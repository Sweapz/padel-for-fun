# Public browser configuration only. Never add a password or privileged API key.
# start/watch/build:local allow development settings. The production build requires
# PADEL_STORAGE=supabase and a remote HTTPS URL, not localhost/private addresses.
PADEL_STORAGE=local
# For shared mode, set PADEL_STORAGE=supabase and supply all three public settings:
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# PADEL_LOGIN_EMAIL=your-shared-account-email
