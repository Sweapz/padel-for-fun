{
  "name": "padel-americano",
  "version": "0.2.0",
  "scripts": {
    "prestart": "node --env-file-if-exists=.env scripts/generate-config.mjs",
    "prebuild": "node --env-file-if-exists=.env scripts/generate-config.mjs --production",
    "prewatch": "node --env-file-if-exists=.env scripts/generate-config.mjs",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:local": "node --env-file-if-exists=.env scripts/generate-config.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:config": "node --test scripts/public-settings.spec.mjs",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@supabase/supabase-js": "2.118.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
